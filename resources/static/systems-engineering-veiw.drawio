<mxfile>
  <diagram name="CrowdSec Compact View v2" id="crowdsec-compact">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Internet -->
        <mxCell id="internet" value="INTERNET / EXTERNAL USERS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="220" height="45" as="geometry" />
        </mxCell>

        <!-- Boundary A -->
        <mxCell id="boundaryA" value="TRUST BOUNDARY A — Internet &#8596; Enterprise Edge" style="line;strokeColor=#B20000;strokeWidth=2;fontColor=#B20000;fontStyle=1;verticalAlign=bottom;labelPosition=center;align=center;spacingBottom=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="900" height="10" as="geometry" />
        </mxCell>

        <!-- Edge -->
        <mxCell id="edge" value="Edge: Firewall/WAF + Bouncer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="270" y="110" width="240" height="45" as="geometry" />
        </mxCell>

        <!-- Monitored systems -->
        <mxCell id="monitored" value="Monitored Systems (web/app/internal)&#10;+ Log Processor (detection agent)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="250" y="180" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- Boundary B -->
        <mxCell id="boundaryB" value="TRUST BOUNDARY B — Hosts &#8596; Decision plane&#10;(agent auth: login/password, or TLS cert)" style="line;strokeColor=#B20000;strokeWidth=2;fontColor=#B20000;fontStyle=1;verticalAlign=bottom;labelPosition=center;align=center;spacingBottom=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="260" width="900" height="10" as="geometry" />
        </mxCell>

        <!-- LAPI + CAPI -->
        <mxCell id="lapi" value="LAPI&#10;(Local API / Decision Store)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="300" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="capi" value="CAPI&#10;(Central API)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="300" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- Boundary C (main pipeline only) -->
        <mxCell id="boundaryC" value="TRUST BOUNDARY C — Decisions &#8596; Enforcement&#10;(bouncer auth: API key)" style="line;strokeColor=#B20000;strokeWidth=2;fontColor=#B20000;fontStyle=1;verticalAlign=bottom;labelPosition=center;align=center;spacingBottom=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="380" width="640" height="10" as="geometry" />
        </mxCell>

        <!-- Bouncers -->
        <mxCell id="webBouncer" value="Web Bouncer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fwBouncer" value="Firewall Bouncer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="410" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="otherBouncer" value="Other Bouncers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="410" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- External network -->
        <mxCell id="external" value="CrowdSec Central Network&#10;(Community Threat Intel)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="690" y="415" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Boundary D (main pipeline only) -->
        <mxCell id="boundaryD" value="TRUST BOUNDARY D — Ops &#8596; Management" style="line;strokeColor=#B20000;strokeWidth=2;fontColor=#B20000;fontStyle=1;verticalAlign=bottom;labelPosition=center;align=center;spacingBottom=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="480" width="640" height="10" as="geometry" />
        </mxCell>

        <!-- Admins + Console -->
        <mxCell id="console" value="Admins/SOC + CrowdSec Console&#10;(reporting, policy mgmt)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="270" y="500" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- Boundary E: vertical, LAPI/CAPI side only -->
        <mxCell id="boundaryE" value="TRUST BOUNDARY E&#10;Enterprise &#8596; External CrowdSec Network" style="line;strokeColor=#B20000;strokeWidth=2;fontColor=#B20000;fontStyle=1;direction=north;horizontal=0;verticalAlign=bottom;labelPosition=center;align=center;spacingBottom=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="655" y="290" width="10" height="200" as="geometry" />
        </mxCell>

        <!-- Arrows: main pipeline -->
        <mxCell id="e1" value="attacks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="internet" target="edge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="allow/block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="edge" target="monitored">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="monitored" target="lapi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="decisions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="lapi" target="webBouncer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="lapi" target="fwBouncer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="decisions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="lapi" target="otherBouncer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LAPI <-> CAPI -->
        <mxCell id="e7" value="signals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="lapi" target="capi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="community blocklist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="capi" target="lapi">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="690" y="345" />
              <mxPoint x="490" y="345" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- CAPI <-> External network -->
        <mxCell id="e9" value="push signals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="capi" target="external">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="pull blocklist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="external" target="capi">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850" y="415" />
              <mxPoint x="850" y="355" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Console optional link to LAPI -->
        <mxCell id="e11" value="optional: console-managed decisions / blocklist subscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#555555;fontColor=#555555;" edge="1" parent="1" source="console" target="lapi">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="527" />
              <mxPoint x="330" y="355" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
