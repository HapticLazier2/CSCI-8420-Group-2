<diagram id="C5" name="C5 Community Intelligence">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10"
      page="1" pageWidth="1200" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="c5" value="C5 — Community Intelligence&#xa;Community intelligence does not cause sustained blocking of legitimate IP addresses or undermine local detection."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="500" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="c51" value="C5.1 — Blocklist entries meet defined validation criteria."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r51" value="R5.1 — Poisoned or low-confidence reputation data may cause false blocking."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e51" value="E5.1 — Use case: validated threat-intelligence update; misuse case: poisoned reputation feed. Evidence: feed-validation rules, false-positive measurements, and blocklist acceptance-test report."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
