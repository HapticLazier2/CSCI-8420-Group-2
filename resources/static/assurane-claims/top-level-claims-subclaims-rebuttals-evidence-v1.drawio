<mxfile host="app.diagrams.net">
  <diagram id="C1" name="C1 Log Ingestion">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10"
      page="1" pageWidth="1200" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="c1" value="C1 — Log Ingestion&#xa;The ingestion pipeline maintains detection under forged, malformed, or oversized input."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="500" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="c11" value="C1.1 — Network log sources are authenticated."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r11" value="R1.1 — Compromised credentials or spoofed source identities may bypass authentication."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="E1.1 — Use case: authenticated log forwarding; misuse case: spoofed sender. Evidence: authentication test results, certificate-validation records, and negative spoofing-test report."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="c12" value="C1.2 — Oversized input cannot crash the agent."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r12" value="R1.2 — Unanticipated input sizes or parser defects may exhaust resources."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="E1.2 — Use case: normal log ingestion; misuse case: oversized log flood. Evidence: boundary-value test results, peak-memory measurements, and load-test report."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="c13" value="C1.3 — Forged logs cannot frame trusted IP addresses."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r13" value="R1.3 — Attacker-controlled log fields may misattribute malicious activity."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="E1.3 — Use case: accurate source attribution; misuse case: forged IP fields. Evidence: parser test corpus, source-attribution test results, and false-attribution measurements."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="a11" edge="1" parent="1" source="c1" target="c11" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a12" edge="1" parent="1" source="c1" target="c12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a13" edge="1" parent="1" source="c1" target="c13" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="b11" value="R1.1" edge="1" parent="1" source="c11" target="r11" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b12" value="R1.2" edge="1" parent="1" source="c12" target="r12" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b13" value="R1.3" edge="1" parent="1" source="c13" target="r13" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="f11" edge="1" parent="1" source="r11" target="e11" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f12" edge="1" parent="1" source="r12" target="e12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f13" edge="1" parent="1" source="r13" target="e13" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

<diagram id="C2" name="C2 AppSec Inspection">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10"
      page="1" pageWidth="1200" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="c2" value="C2 — AppSec Inspection&#xa;The inspection component detects and blocks known attack payloads across supported request framings and operating loads."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="500" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="c21" value="C2.1 — Every supported request framing is inspected."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r21" value="R2.1 — Encoding differences or parser inconsistencies may bypass inspection."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e21" value="E2.1 — Use case: inspection of supported requests; misuse case: encoded or fragmented attack payload. Evidence: request-framing test matrix, payload corpus, and detection-coverage report."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="c22" value="C2.2 — Inspection failures follow a documented fail-safe policy."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r22" value="R2.2 — Fail-open behavior may permit malicious traffic during component failure."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e22" value="E2.2 — Use case: normal inspection; misuse case: inspection-engine crash or timeout. Evidence: failure-injection results, fail-open/fail-closed configuration review, and recovery test report."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="c23" value="C2.3 — High traffic cannot silently disable inspection."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r23" value="R2.3 — Resource exhaustion may cause dropped requests or reduced inspection coverage."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e23" value="E2.3 — Use case: inspection during peak traffic; misuse case: request flood. Evidence: throughput benchmarks, resource-utilization metrics, and overload-resilience test report."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="a21" edge="1" parent="1" source="c2" target="c21" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a22" edge="1" parent="1" source="c2" target="c22" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a23" edge="1" parent="1" source="c2" target="c23" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="b21" value="R2.1" edge="1" parent="1" source="c21" target="r21" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b22" value="R2.2" edge="1" parent="1" source="c22" target="r22" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b23" value="R2.3" edge="1" parent="1" source="c23" target="r23" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="f21" edge="1" parent="1" source="r21" target="e21" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f22" edge="1" parent="1" source="r22" target="e22" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f23" edge="1" parent="1" source="r23" target="e23" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

<diagram id="C3" name="C3 Decision Channel">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10"
      page="1" pageWidth="1200" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="c3" value="C3 — Decision Channel&#xa;Security decisions reach only authorized enforcement points and remain protected against alteration in transit."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="500" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="c31" value="C3.1 — Credentials are unique, revocable, and least-privileged."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r31" value="R3.1 — Stolen or overprivileged credentials may permit unauthorized decisions."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e31" value="E3.1 — Use case: authorized service authentication; misuse case: stolen credential reuse. Evidence: access-control matrix, credential-revocation test results, and authorization audit records."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="c32" value="C3.2 — Decision traffic is protected in transit."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r32" value="R3.2 — A network attacker may intercept, replay, or alter decision messages."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e32" value="E3.2 — Use case: protected decision delivery; misuse case: message tampering or replay. Evidence: transport-security configuration, packet-capture analysis, and tampering/replay test results."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="c33" value="C3.3 — Only validated machines can submit alerts or decisions."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r33" value="R3.3 — An unregistered or compromised machine may inject false alerts."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e33" value="E3.3 — Use case: alert submission by a registered machine; misuse case: unauthorized alert injection. Evidence: machine-identity validation tests, enrollment records, and rejected-request logs."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="a31" edge="1" parent="1" source="c3" target="c31" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a32" edge="1" parent="1" source="c3" target="c32" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a33" edge="1" parent="1" source="c3" target="c33" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="b31" value="R3.1" edge="1" parent="1" source="c31" target="r31" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b32" value="R3.2" edge="1" parent="1" source="c32" target="r32" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b33" value="R3.3" edge="1" parent="1" source="c33" target="r33" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="f31" edge="1" parent="1" source="r31" target="e31" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f32" edge="1" parent="1" source="r32" target="e32" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f33" edge="1" parent="1" source="r33" target="e33" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
