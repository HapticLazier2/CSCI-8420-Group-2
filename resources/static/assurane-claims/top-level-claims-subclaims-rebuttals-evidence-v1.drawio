<diagram id="C4" name="C4 Policy Management">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10"
      page="1" pageWidth="1200" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="c4" value="C4 — Policy Management&#xa;Policy changes are authorized, attributable, validated, and unable to silently disable required detection."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="500" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="c41" value="C4.1 — Hub content is vetted before use."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r41" value="R4.1 — Malicious or compromised content may introduce unsafe detection rules."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e41" value="E4.1 — Use case: approved parser or rule update; misuse case: malicious hub content. Evidence: content-signature verification results, rule-review checklist, and sandbox validation report."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="c42" value="C4.2 — Administrative policy changes are attributable."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r42" value="R4.2 — Shared accounts or incomplete audit records may conceal unauthorized changes."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e42" value="E4.2 — Use case: approved administrator update; misuse case: unauthorized policy modification. Evidence: immutable audit-log samples, role-assignment records, and change-attribution test results."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="c43" value="C4.3 — Invalid configuration cannot be activated."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="160" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r43" value="R4.3 — Malformed or overly permissive configuration may disable detection."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="270" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e43" value="E4.3 — Use case: validated policy deployment; misuse case: invalid or detection-disabling configuration. Evidence: schema-validation test results, configuration rollback logs, and policy regression-test report."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="390" width="310" height="110" as="geometry"/>
        </mxCell>

