<mxfile host="app.diagrams.net">
  <diagram id="crowdsec-top-claims" name="Top-Level Claims">
    <mxGraphModel dx="1560" dy="1158" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#1F4E78;strokeWidth=2;fontSize=13;align=left;spacing=12;arcSize=8;" value="&lt;b&gt;C1 — Resilient and Trustworthy Log Ingestion&lt;/b&gt;&lt;br&gt;&lt;br&gt;The ingestion pipeline preserves detection integrity and service availability under forged, malformed, distributed, and oversized inputs." vertex="1">
          <mxGeometry height="160" width="285" x="90" y="210" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#1F4E78;strokeWidth=2;fontSize=13;align=left;spacing=12;arcSize=8;" value="&lt;b&gt;C2 — Reliable Application-Layer Protection&lt;/b&gt;&lt;br&gt;&lt;br&gt;AppSec inspects supported HTTP request formats and enforces policy without silently allowing malicious requests when inspection fails." vertex="1">
          <mxGeometry height="160" width="285" x="380" y="400" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#1F4E78;strokeWidth=2;fontSize=13;align=left;spacing=12;arcSize=8;" value="&lt;b&gt;C3 — Trusted Decision Distribution and Enforcement&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decision access is restricted to authorized components, and decision exchanges are protected for authenticity, integrity, and availability." vertex="1">
          <mxGeometry height="160" width="285" x="653.5" y="600" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#1F4E78;strokeWidth=2;fontSize=13;align=left;spacing=12;arcSize=8;" value="&lt;b&gt;C4 — Controlled Policy and Detection Management&lt;/b&gt;&lt;br&gt;&lt;br&gt;Administrative and content-management processes prevent unauthorized or unsafe changes from silently compromising detection and remediation." vertex="1">
          <mxGeometry height="160" width="285" x="920" y="400" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#1F4E78;strokeWidth=2;fontSize=13;align=left;spacing=12;arcSize=8;" value="&lt;b&gt;C5 — Trustworthy Community Threat Intelligence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Threat-intelligence exchanges protect data integrity and confidentiality while limiting inappropriate blocking and disruption of local protection." vertex="1">
