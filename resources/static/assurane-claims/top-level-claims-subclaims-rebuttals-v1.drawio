<mxfile host="app.diagrams.net">
  <diagram id="C1" name="C1 Log Ingestion">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="C1 — Log Ingestion&#xa;The ingestion pipeline maintains detection under forged, malformed, or oversized input." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="30" width="500" height="80" as="geometry"/></mxCell>
        <mxCell id="c11" value="C1.1 — Network log sources are authenticated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="310" height="60" as="geometry"/></mxCell>
        <mxCell id="c12" value="C1.2 — Oversized input cannot crash the agent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="445" y="190" width="310" height="60" as="geometry"/></mxCell>
        <mxCell id="c13" value="C1.3 — Forged logs cannot frame trusted IP addresses." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="850" y="190" width="310" height="60" as="geometry"/></mxCell>
        <mxCell id="r11" value="R1.1 — Compromised credentials or spoofed source identities may bypass authentication." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="310" height="75" as="geometry"/></mxCell>
        <mxCell id="r12" value="R1.2 — Unanticipated input sizes or parser defects may exhaust resources." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="445" y="330" width="310" height="75" as="geometry"/></mxCell>
        <mxCell id="r13" value="R1.3 — Attacker-controlled log fields may misattribute malicious activity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="850" y="330" width="310" height="75" as="geometry"/></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="c1" target="c11" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="c1" target="c12" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="c1" target="c13" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="c11" target="r11" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="c12" target="r12" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="c13" target="r13" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

<diagram id="C2" name="C2 AppSec Inspection">
  <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="850">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="c2" value="C2 — AppSec Inspection&#xa;AppSec reliably detects known attack payloads across request framings and operating loads." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="30" width="500" height="80" as="geometry"/></mxCell>
      <mxCell id="c21" value="C2.1 — Every supported request framing is inspected." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="c22" value="C2.2 — Inspection failures follow a fail-safe policy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="445" y="190" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="c23" value="C2.3 — Excessive load cannot silently disable inspection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="850" y="190" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="r21" value="R2.1 — Unsupported or ambiguous request encodings may evade inspection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="r22" value="R2.2 — Fail-open behavior may permit malicious requests during inspection errors." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="445" y="330" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="r23" value="R2.3 — Resource exhaustion may cause inspection delays or bypasses." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="850" y="330" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="e21" edge="1" parent="1" source="c2" target="c21" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e22" edge="1" parent="1" source="c2" target="c22" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e23" edge="1" parent="1" source="c2" target="c23" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e24" edge="1" parent="1" source="c21" target="r21" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e25" edge="1" parent="1" source="c22" target="r22" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e26" edge="1" parent="1" source="c23" target="r23" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root>
  </mxGraphModel>
</diagram>

<diagram id="C3" name="C3 Decision Channel">
  <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="850">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="c3" value="C3 — Decision Channel&#xa;Security decisions reach only authorized enforcement points and remain protected against alteration in transit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="30" width="500" height="80" as="geometry"/></mxCell>
      <mxCell id="c31" value="C3.1 — Credentials are unique, revocable, and least-privileged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="c32" value="C3.2 — Decision traffic is protected in transit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="445" y="190" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="c33" value="C3.3 — Only validated machines can submit alerts or decisions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="850" y="190" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="r31" value="R3.1 — Stolen or overprivileged credentials may enable unauthorized decisions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="r32" value="R3.2 — Misconfigured encryption or certificate validation may permit interception." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="445" y="330" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="r33" value="R3.3 — Compromised or incorrectly enrolled machines may inject false alerts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="850" y="330" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="e31" edge="1" parent="1" source="c3" target="c31" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e32" edge="1" parent="1" source="c3" target="c32" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e33" edge="1" parent="1" source="c3" target="c33" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e34" edge="1" parent="1" source="c31" target="r31" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e35" edge="1" parent="1" source="c32" target="r32" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e36" edge="1" parent="1" source="c33" target="r33" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root>
  </mxGraphModel>
</diagram>

<diagram id="C4" name="C4 Policy Management">
  <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="850">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="c4" value="C4 — Policy Management&#xa;Policy changes are authorized, attributable, validated, and unable to silently disable detection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="30" width="500" height="80" as="geometry"/></mxCell>
      <mxCell id="c41" value="C4.1 — External hub content is vetted before use." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="c42" value="C4.2 — Administrative actions are attributable to individual identities." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="445" y="190" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="c43" value="C4.3 — Invalid or unsafe configurations cannot be activated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="850" y="190" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="r41" value="R4.1 — Malicious or compromised upstream content may pass inadequate review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="r42" value="R4.2 — Shared accounts or incomplete audit records may prevent attribution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="445" y="330" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="r43" value="R4.3 — Validation gaps or unsafe rollback behavior may activate defective policies." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="850" y="330" width="310" height="75" as="geometry"/></mxCell>
      <mxCell id="e41" edge="1" parent="1" source="c4" target="c41" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e42" edge="1" parent="1" source="c4" target="c42" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e43" edge="1" parent="1" source="c4" target="c43" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e44" edge="1" parent="1" source="c41" target="r41" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e45" edge="1" parent="1" source="c42" target="r42" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e46" edge="1" parent="1" source="c43" target="r43" value="Rebuttal" style="endArrow=open;dashed=1;strokeColor=#b85450;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root>
  </mxGraphModel>
