          vertex="1" parent="1">
          <mxGeometry x="445" y="300" width="310" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="r53" value="R5.3 — Unless compromised signing keys or feed infrastructure distribute altered intelligence."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="300" width="310" height="85" as="geometry"/>
