  </diagram>

  <diagram id="C3" name="C3 Decision Channel">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="c3" value="C3 — Decision Channel&#xa;Security decisions reach only authorized enforcement points and remain protected against alteration in transit."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="500" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="c31" value="C3.1 — Credentials are unique, revocable, and least-privileged."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c32" value="C3.2 — Decision traffic is protected in the transport layer."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="170" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c33" value="C3.3 — Only validated machines can submit alerts or decisions."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="170" width="310" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="r31" value="R3.1 — Unless stolen or overprivileged credentials enable unauthorized decisions."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="310" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="r32" value="R3.2 — Unless TLS is disabled, misconfigured, or certificate validation fails."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="300" width="310" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="r33" value="R3.3 — Unless compromised or incorrectly enrolled machines inject false alerts."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="300" width="310" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="a31" edge="1" parent="1" source="c3" target="c31" style="endArrow=block;html=1;">
