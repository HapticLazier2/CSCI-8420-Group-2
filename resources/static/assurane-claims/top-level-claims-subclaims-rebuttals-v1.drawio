  </diagram>

<diagram id="C2" name="C2 AppSec Inspection">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="c2" value="C2 — AppSec Inspection&#xa;AppSec reliably detects known attack payloads across request framings and operating loads."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="500" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="c21" value="C2.1 — Every supported request framing is inspected."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c22" value="C2.2 — Inspection failures follow a fail-safe policy."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="170" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c23" value="C2.3 — Excessive load cannot silently disable inspection."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="170" width="310" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="r21" value="R2.1 — Unless unsupported or ambiguous request encodings evade inspection."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="310" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="r22" value="R2.2 — Unless fail-open behavior permits malicious requests during inspection errors."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="300" width="310" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="r23" value="R2.3 — Unless resource exhaustion causes inspection delays or bypasses."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="300" width="310" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="a21" edge="1" parent="1" source="c2" target="c21" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a22" edge="1" parent="1" source="c2" target="c22" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a23" edge="1" parent="1" source="c2" target="c23" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="b21" value="Unless" edge="1" parent="1" source="c21" target="r21" style="dashed=1;endArrow=open;strokeColor=#b85450;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b22" value="Unless" edge="1" parent="1" source="c22" target="r22" style="dashed=1;endArrow=open;strokeColor=#b85450;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b23" value="Unless" edge="1" parent="1" source="c23" target="r23" style="dashed=1;endArrow=open;strokeColor=#b85450;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
