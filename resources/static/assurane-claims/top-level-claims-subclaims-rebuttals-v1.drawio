<diagram id="C5" name="C5 Community Intelligence">
  <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="850">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="c5" value="C5 — Community Intelligence&#xa;Community intelligence does not cause sustained blocking of legitimate IP addresses or undermine local detection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="30" width="500" height="80" as="geometry"/></mxCell>
      <mxCell id="c51" value="C5.1 — Blocklist entries meet defined validation and corroboration criteria." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="310" height="60" as="geometry"/></mxCell>
      <mxCell id="c52" value="C5.2 — Local allowlists and emergency overrides take precedence over community data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="445" y="190" width="310" height="60" as="geometry"/></mxCell>
