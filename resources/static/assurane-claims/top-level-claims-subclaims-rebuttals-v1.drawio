  <diagram id="C4" name="C4 Policy Management">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="c4" value="C4 — Policy Management&#xa;Policy changes are authorized, attributable, validated, and unable to silently disable detection."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="500" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="c41" value="C4.1 — External hub content is vetted before use."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c42" value="C4.2 — Administrative actions are attributable to individual identities."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="170" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c43" value="C4.3 — Invalid or unsafe configurations cannot be activated."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="170" width="310" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="r41" value="R4.1 — Unless malicious or compromised upstream content passes inadequate review."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="310" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="r42" value="R4.2 — Unless shared accounts or incomplete audit records prevent attribution."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="445" y="300" width="310" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="r43" value="R4.3 — Unless validation gaps or unsafe rollback behavior activate defective policies."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="300" width="310" height="85" as="geometry"/>
