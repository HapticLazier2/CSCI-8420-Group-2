<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0" type="device">

  <!-- ===================================================== -->
  <!-- 01 - ANALYZE SECURITY EVENTS                         -->
  <!-- ===================================================== -->

  <diagram id="crowdsec-use-01" name="01 - Analyze Security Events">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10"
      guides="1" tooltips="1" connect="1" arrows="1"
      fold="1" page="1" pageScale="1" pageWidth="1200"
      pageHeight="850" math="0" shadow="0">

      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ENTERPRISE ENVIRONMENT -->
        <mxCell id="enterprise01"
          value="ENTERPRISE ENVIRONMENT"
          style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#666666;fillColor=#ffffff;fontStyle=1;verticalAlign=top;align=center;spacingTop=10;"
          vertex="1" parent="1">
          <mxGeometry x="220" y="70" width="850" height="650" as="geometry"/>
        </mxCell>

        <!-- CROWDSec SYSTEM -->
        <mxCell id="system01"
          value="CrowdSec System"
          style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#17365d;fillColor=#f5f5f5;fontStyle=1;verticalAlign=top;align=center;spacingTop=35;"
          vertex="1" parent="1">
          <mxGeometry x="430" y="180" width="430" height="410" as="geometry"/>
        </mxCell>

        <!-- USE CASE -->
        <mxCell id="use01"
          value="Analyze Security Events"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2e7d32;strokeWidth=2;"
          vertex="1" parent="1">
          <mxGeometry x="525" y="315" width="240" height="90" as="geometry"/>
        </mxCell>

        <!-- EXTERNAL INTERACTOR -->
        <mxCell id="actor01"
          value="Splunk Enterprise&#10;(SIEM / Log Management)"
          style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="100" height="120" as="geometry"/>
        </mxCell>

        <!-- MISUSER -->
        <mxCell id="misuser01"
          value="Attacker /&#10;Compromised Host"
          style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeColor=#b71c1c;"
          vertex="1" parent="1">
          <mxGeometry x="1120" y="310" width="100" height="120" as="geometry"/>
        </mxCell>

        <!-- MISUSE -->
        <mxCell id="misuse01"
          value="&lt;&lt;misuse&gt;&gt;&#10;Poison Detection Input"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b71c1c;strokeWidth=2;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="505" y="475" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- NORMAL INTERACTION -->
        <mxCell id="edge01a"
          value="security events"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;"
          edge="1" parent="1" source="actor01" target="use01">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- MISUSE -->
        <mxCell id="edge01b"
          value="inject / manipulate"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b71c1c;endArrow=none;"
          edge="1" parent="1" source="misuser01" target="misuse01">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- THREAT -->
        <mxCell id="edge01c"
          value="&lt;&lt;threatens&gt;&gt;"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b71c1c;endArrow=block;endFill=0;"
          edge="1" parent="1" source="misuse01" target="use01">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>


