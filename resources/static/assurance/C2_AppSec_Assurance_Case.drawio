<mxfile host="app.diagrams.net"><diagram name="C2 AppSec" id="c2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="&lt;b&gt;Top Claim C2:&lt;/b&gt; AppSec blocks known-malicious HTTP requests before they reach enterprise web applications, whatever the body framing or AppSec load" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="941" y="20" width="210" height="74" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Rebuttal R2.1:&lt;/b&gt; Unless a request reaches an application without passing through AppSec" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="83" y="132" width="190" height="62" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Sub-Claim C2.1:&lt;/b&gt; Every network route to the enterprise web applications passes through an AppSec-enabled bouncer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="73" y="232" width="210" height="74" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Evidence E2.1.1:&lt;/b&gt; Reverse-proxy configuration audit report" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="33" y="344" width="132" height="132" as="geometry"/></mxCell><mxCell id="n4" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="88" y="492" width="22" height="22" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Evidence E2.1.2:&lt;/b&gt; Network scan results for direct paths to application origins" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="191" y="344" width="132" height="132" as="geometry"/></mxCell><mxCell id="n6" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="246" y="492" width="22" height="22" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Rebuttal R2.2:&lt;/b&gt; Unless the enabled rules miss a known attack payload" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="557" y="132" width="190" height="62" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Sub-Claim C2.2:&lt;/b&gt; The enabled rule sets deny known SQLi, XSS and CVE exploit payloads in the URI, headers and body" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="547" y="232" width="210" height="74" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Rebuttal R2.2.1:&lt;/b&gt; Unless rules log attacks without blocking them" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="399" y="344" width="190" height="62" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Sub-Claim C2.2.1:&lt;/b&gt; Every enabled attack rule denies matching requests in production" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="389" y="444" width="210" height="74" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Evidence E2.2.1:&lt;/b&gt; Attack-payload regression test results" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="349" y="556" width="132" height="132" as="geometry"/></mxCell><mxCell id="n12" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="404" y="704" width="22" height="22" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Evidence E2.2.2:&lt;/b&gt; In-band rule inventory for each AppSec configuration" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="507" y="556" width="132" height="132" as="geometry"/></mxCell><mxCell id="n14" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="562" y="704" width="22" height="22" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Rebuttal R2.2.2:&lt;/b&gt; Unless the installed rules are out of date" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="715" y="344" width="190" height="62" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Sub-Claim C2.2.2:&lt;/b&gt; Installed rule sets are at most 24 hours behind the current Hub release" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="705" y="444" width="210" height="74" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Evidence E2.2.3:&lt;/b&gt; Hub upgrade job logs" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="665" y="556" width="132" height="132" as="geometry"/></mxCell><mxCell id="n18" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="720" y="704" width="22" height="22" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Evidence E2.2.4:&lt;/b&gt; Installed-versus-Hub rule version comparison report" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="823" y="556" width="132" height="132" as="geometry"/></mxCell><mxCell id="n20" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="878" y="704" width="22" height="22" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Rebuttal R2.3:&lt;/b&gt; Unless the payload is hidden in a body framing that AppSec does not read" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1149" y="132" width="190" height="62" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Sub-Claim C2.3:&lt;/b&gt; AppSec inspects the request body for every supported body framing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1139" y="232" width="210" height="74" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Rebuttal R2.3.1:&lt;/b&gt; Unless the engine skips bodies that have no positive Content-Length" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="991" y="344" width="190" height="62" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Sub-Claim C2.3.1:&lt;/b&gt; The AppSec engine reads chunked and HTTP/2 bodies that carry no Content-Length" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="981" y="444" width="210" height="74" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Evidence E2.3.1:&lt;/b&gt; Negative test results for each body framing" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="556" width="132" height="132" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Undermine UM2.3.1:&lt;/b&gt; Unless the tests ran on a build other than the deployed one" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#9FC5E8;strokeColor=#6C8EBF;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="991" y="726" width="190" height="62" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Sub-Claim C2.3.1.1:&lt;/b&gt; The tested build and configuration match production" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="981" y="826" width="210" height="74" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Evidence E2.3.2:&lt;/b&gt; Build and configuration manifest of the test environment" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="938" width="132" height="132" as="geometry"/></mxCell><mxCell id="n29" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1075" y="1086" width="22" height="22" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Rebuttal R2.3.2:&lt;/b&gt; Unless the bouncer forwards a request without its body" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1267" y="344" width="190" height="62" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Sub-Claim C2.3.2:&lt;/b&gt; The bouncer rejects every request whose body it cannot forward to AppSec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1257" y="444" width="210" height="74" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Evidence E2.3.3:&lt;/b&gt; Unreadable-body test results for HTTP/2 and HTTP/3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="1217" y="556" width="132" height="132" as="geometry"/></mxCell><mxCell id="n33" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1272" y="704" width="22" height="22" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;Evidence E2.3.4:&lt;/b&gt; Bouncer configuration baseline" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="1375" y="556" width="132" height="132" as="geometry"/></mxCell><mxCell id="n35" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1430" y="704" width="22" height="22" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Rebuttal R2.4:&lt;/b&gt; Unless AppSec overload or outage lets requests through uninspected" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1701" y="132" width="190" height="62" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Sub-Claim C2.4:&lt;/b&gt; No request reaches an application without an AppSec verdict while AppSec is slow or unavailable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1691" y="232" width="210" height="74" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;Rebuttal R2.4.1:&lt;/b&gt; Unless bouncers pass requests through on timeout or error" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1583" y="344" width="190" height="62" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Sub-Claim C2.4.1:&lt;/b&gt; Every production bouncer denies requests when AppSec times out or returns an error" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1573" y="444" width="210" height="74" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;Evidence E2.4.1:&lt;/b&gt; Fault-injection and peak-load test results" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="1533" y="556" width="132" height="132" as="geometry"/></mxCell><mxCell id="n41" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1588" y="704" width="22" height="22" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b&gt;Evidence E2.4.2:&lt;/b&gt; Failure-action and timeout configuration audit report" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="1691" y="556" width="132" height="132" as="geometry"/></mxCell><mxCell id="n43" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1746" y="704" width="22" height="22" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b&gt;Rebuttal R2.4.2:&lt;/b&gt; Unless an uninspected request passes unnoticed" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1859" y="344" width="190" height="62" as="geometry"/></mxCell><mxCell id="n45" value="&lt;b&gt;Sub-Claim C2.4.2:&lt;/b&gt; Every request passed without an AppSec verdict raises a SOC alert" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1849" y="444" width="210" height="74" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b&gt;Evidence E2.4.3:&lt;/b&gt; Fail-open alert test records from the SIEM" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="1888" y="556" width="132" height="132" as="geometry"/></mxCell><mxCell id="n47" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B3B3B3;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1943" y="704" width="22" height="22" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;Context CT2:&lt;/b&gt; Requests forwarded by AppSec-enabled NGINX bouncers to CrowdSec AppSec v1.8.x; &amp;quot;known-malicious&amp;quot; means matching an enabled rule (UC-2, SR-2.1 to SR-2.4)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1241" y="15" width="250" height="84" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Justification J2:&lt;/b&gt; CVE-2026-44982 let payloads skip body inspection in v1.5.0 to v1.7.7, and the bouncer fails open by default" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1531" y="15" width="250" height="84" as="geometry"/></mxCell><mxCell id="e0" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" sty